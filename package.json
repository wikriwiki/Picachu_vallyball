{
  "name": "online-game-of-life",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "인생게임 for Nintendo Switch 스타일 온라인 멀티플레이 보드게임 (TypeScript + Three.js + GLSL + WebSocket)",
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/run.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "0.180.0",
    "tsx": "^4.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "0.180.0",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
